# ============================================
# DJANGO — CORE
# ============================================
# Generate a secure key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# DATABASE
# ============================================
# Dev uses SQLite by default — no variables needed.
# Uncomment and fill the block below to switch to PostgreSQL.
#
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=newsblog
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432

# ============================================
# EMAIL (optional — password reset, notifications)
# ============================================
# For Gmail, use an "App Password", not your account password:
#   https://myaccount.google.com/apppasswords
#
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=NewsBlog <no-reply@newsblog.local>

# ============================================
# STATIC & MEDIA (production only)
# ============================================
# STATIC_ROOT=/var/www/newsblog/staticfiles/
# MEDIA_ROOT=/var/www/newsblog/media/

# ============================================
# SECURITY (production only)
# ============================================
# CSRF_TRUSTED_ORIGINS=https://newsblog.example.com
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True